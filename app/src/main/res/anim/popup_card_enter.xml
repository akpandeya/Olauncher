<?xml version="1.0" encoding="utf-8"?>
<!-- Fade and grow in; the exit is a plain fade. Both are off when system animations are off (NoAnimationOverlay). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/popup_card_anim_duration"
    android:interpolator="@android:interpolator/decelerate_quad">
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
    <scale
        android:fromXScale="0.92"
        android:fromYScale="0.92"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
