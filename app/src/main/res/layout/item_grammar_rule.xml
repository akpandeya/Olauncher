<?xml version="1.0" encoding="utf-8"?>
<!-- One grammar-rules index row (#792): the rule's title in body bold, its
     one-line plain-English rule underneath in muted body. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/today_touch_min_height"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tvRuleTitle"
        style="@style/TodayCardBodyBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        tools:text="Two-way prepositions" />

    <TextView
        android:id="@+id/tvRuleLine"
        style="@style/TodayCardBodyLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        tools:text="This is a two-way preposition. Wohin? means movement to a place." />

</LinearLayout>
