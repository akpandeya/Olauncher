<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sheetAppActionsRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingVertical="16dp">

    <TextView
        android:id="@+id/actionAddToHome"
        style="@style/TextMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="?attr/mainFontFamily"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/drawer_row_padding_horizontal"
        android:paddingVertical="12dp"
        android:text="@string/add_to_home"
        android:textColor="?attr/primaryColor"
        tools:text="Add to home" />

    <TextView
        android:id="@+id/actionRename"
        style="@style/TextMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="?attr/mainFontFamily"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/drawer_row_padding_horizontal"
        android:paddingVertical="12dp"
        android:text="@string/rename"
        android:textColor="?attr/primaryColor"
        tools:text="Rename" />

    <TextView
        android:id="@+id/actionHide"
        style="@style/TextMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="?attr/mainFontFamily"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/drawer_row_padding_horizontal"
        android:paddingVertical="12dp"
        android:text="@string/hide"
        android:textColor="?attr/primaryColor"
        tools:text="Hide" />

    <TextView
        android:id="@+id/actionDistracting"
        style="@style/TextMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="?attr/mainFontFamily"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/drawer_row_padding_horizontal"
        android:paddingVertical="12dp"
        android:text="@string/mark_distracting"
        android:textColor="?attr/primaryColor"
        tools:text="Mark distracting" />

    <TextView
        android:id="@+id/actionAppInfo"
        style="@style/TextMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="?attr/mainFontFamily"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/drawer_row_padding_horizontal"
        android:paddingVertical="12dp"
        android:text="@string/app_info"
        android:textColor="?attr/primaryColor"
        tools:text="App info" />

    <TextView
        android:id="@+id/actionUninstall"
        style="@style/TextMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="?attr/mainFontFamily"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/drawer_row_padding_horizontal"
        android:paddingVertical="12dp"
        android:text="@string/delete"
        android:textColor="?attr/primaryColor"
        tools:text="Uninstall" />

</LinearLayout>
