<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/todayScrimColor"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    tools:context=".ui.words.ConjugationFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="8dp">

            <!-- Quiz: header, progress segments, card -->
            <LinearLayout
                android:id="@+id/quizContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLemma"
                        style="@style/TodayCardLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="machen" />

                    <TextView
                        android:id="@+id/tvProgress"
                        style="@style/TodayCardBodyLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        tools:text="Präsens · 4 of 6" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/segmentRow"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/quizCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/today_panel"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/summaryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/TodayCardLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/conjugation_first_try" />

                    <TextView
                        android:id="@+id/tvScore"
                        style="@style/TodayCardStat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="5 of 6" />

                    <TextView
                        android:id="@+id/tvSummaryNote"
                        style="@style/TodayCardBodyLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/conjugation_summary_note" />

                    <GridLayout
                        android:id="@+id/summaryGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:columnCount="2" />

                </LinearLayout>

            </LinearLayout>

            <!-- Graceful state for words with no verb entry -->
            <TextView
                android:id="@+id/tvEmpty"
                style="@style/TodayCardBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:visibility="gone"
                tools:text="&quot;Haus&quot; isn't a verb in the offline dictionary"
                tools:visibility="visible" />

        </LinearLayout>

    </ScrollView>


    <!-- Pinned action area: always at the bottom, outside the scroll content -->
    <LinearLayout
        android:id="@+id/conjugationFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="48dp">

        <!-- Question and answers together in one card above Continue -->
        <LinearLayout
            android:id="@+id/questionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/today_panel"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/quizCardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPrompt"
                    style="@style/TodayCardBodyLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Conjugate “machen”" />

                <TextView
                    android:id="@+id/tvPronoun"
                    style="@style/TodayCardStat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    tools:text="wir" />

                <TextView
                    android:id="@+id/tvMeaning"
                    style="@style/TodayCardBodyLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="we" />

            </LinearLayout>

        <ScrollView
            android:id="@+id/choiceScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/choiceGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2" />

        </ScrollView>

        <LinearLayout
            android:id="@+id/typedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <EditText
                android:id="@+id/etAnswer"
                style="@style/TodayCardBodyBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/quiz_choice"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:minHeight="@dimen/quiz_choice_min_height"
                android:padding="@dimen/quiz_cell_padding"
                android:shadowColor="@android:color/transparent" />

            <TextView
                android:id="@+id/tvCorrection"
                style="@style/TodayCardBodyBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="?attr/accentColor"
                android:visibility="gone"
                tools:text="machen"
                tools:visibility="visible" />

        </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/btnPrimary"
            style="@style/TodayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/conjugation_check"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btnType"
            style="@style/TodayCardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/conjugation_type_them"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btnSecondary"
            style="@style/TodayCardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/conjugation_done"
            android:visibility="gone"
            tools:visibility="visible" />


        <TextView
            android:id="@+id/licenseNote"
            style="@style/TodayCardBodyLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:linksClickable="true"
            android:paddingTop="12dp"
            android:text="@string/wiktionary_license_note"
            android:textColorLink="?attr/primaryColor"
            android:textSize="@dimen/today_label_size" />


    </LinearLayout>

</LinearLayout>
