<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/todayScrimColor"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    tools:context=".ui.words.ConjugationFragment">

    <ScrollView
        android:id="@+id/conjugationScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="8dp">

            <!-- The drill card, in a panel like the Today cards; tap reveals the form -->
            <LinearLayout
                android:id="@+id/drillCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/today_panel"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvPronoun"
                    style="@style/TextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    tools:text="wir" />

                <TextView
                    android:id="@+id/tvForm"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone"
                    tools:text="machen"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- End-of-drill summary; the drill card hides when it shows -->
            <LinearLayout
                android:id="@+id/summaryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/today_panel"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvSummary"
                    style="@style/TextSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    tools:text="6 forms checked" />

            </LinearLayout>

            <!-- Graceful state for words with no verb entry; fills the viewport to center the line -->
            <TextView
                android:id="@+id/tvEmpty"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:visibility="gone"
                tools:text="&quot;Haus&quot; isn't a verb in the offline dictionary"
                tools:visibility="visible" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/conjugationFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLemma"
                style="@style/TextLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="machen" />

            <TextView
                android:id="@+id/tvProgress"
                style="@style/TextSmallLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFeatureSettings="tnum"
                tools:text="3 / 6" />

            <TextView
                android:id="@+id/btnNext"
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/conjugation_next"
                android:textColor="?attr/accentColor" />

            <TextView
                android:id="@+id/btnRestart"
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/conjugation_restart"
                android:textColor="?attr/accentColor"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/licenseNote"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:linksClickable="true"
            android:paddingTop="12dp"
            android:text="@string/wiktionary_license_note"
            android:textColorLink="?attr/primaryColor"
            android:textSize="@dimen/text_subtitle" />

    </LinearLayout>

</LinearLayout>
