<?xml version="1.0" encoding="utf-8"?>
<!-- One further-reading row (#810): the source name in body bold, its one-line
     angle underneath in muted body; the whole row opens the link's URL. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/today_touch_min_height"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tvLinkSource"
        style="@style/TodayCardBodyBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        tools:text="Lingolia – the four cases" />

    <TextView
        android:id="@+id/tvLinkAngle"
        style="@style/TodayCardBodyLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        tools:text="When each case is used: question words, verb and preposition signal words." />

</LinearLayout>
