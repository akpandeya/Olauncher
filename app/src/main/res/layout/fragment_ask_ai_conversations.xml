<?xml version="1.0" encoding="utf-8"?>
<!-- The all-conversations list (#793, docs/design/german-hidden-surfaces.md
     §4.2, mock frame 5): every stored Ask-AI thread, newest first, with the
     subject kind, the subject title, the "Chat · n turns · date" meta and a
     one-line preview of the last message. A row tap resumes that thread; the
     "＋ New conversation" pill starts a fresh one for the newest subject. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/todayScrimColor"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    tools:context=".ui.words.AskAiConversationsFragment">

    <!-- Pinned header: title, thread count and the New conversation pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TodayCardLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ask_ai_conversations_title" />

            <TextView
                android:id="@+id/tvCount"
                style="@style/TodayCardBodyLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                tools:text="6" />

        </LinearLayout>

        <!-- The screen-level affordance, trailing (mock frame 5); hidden by code
             while no thread exists, because a fresh thread needs a subject. -->
        <TextView
            android:id="@+id/btnNewConversation"
            style="@style/TodayChip.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:background="@drawable/today_chip"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="36dp"
            android:paddingHorizontal="13dp"
            android:paddingVertical="8dp"
            android:shadowRadius="0"
            android:text="@string/ask_ai_sheet_new"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Scrolling body: one tile card per conversation -->
    <ScrollView
        android:id="@+id/conversationsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="2dp"
            android:paddingBottom="48dp">

            <LinearLayout
                android:id="@+id/conversationsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty state: same wording as the thread sheet -->
            <TextView
                android:id="@+id/tvEmpty"
                style="@style/TodayCardBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="@string/ask_ai_sheet_empty"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
