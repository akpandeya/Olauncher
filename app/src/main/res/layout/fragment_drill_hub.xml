<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/todayScrimColor"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    tools:context=".ui.words.DrillHubFragment">

    <!-- Pinned header: title and the two suggestion buttons -->
    <LinearLayout
        android:id="@+id/hubHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TodayCardLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/drills" />

        <TextView
            android:id="@+id/btnContinue"
            style="@style/TodayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            tools:text="Continue: Prepositions" />

        <TextView
            android:id="@+id/btnWeakest"
            style="@style/TodayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            tools:text="Practise weakest: Pronouns" />

    </LinearLayout>

    <!-- Scrolling body: the 9 types in one panel -->
    <ScrollView
        android:id="@+id/hubScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="48dp">

            <LinearLayout
                android:id="@+id/hubRowsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/today_panel"
                android:orientation="vertical"
                android:padding="16dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
