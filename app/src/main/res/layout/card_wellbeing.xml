<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- The card draws its own header: title on the left, Today | 7 days switch on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWellbeingTitle"
            style="@style/TodayCardLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wellbeing" />

        <LinearLayout
            android:id="@+id/llRangeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRangeToday"
                style="@style/TodayChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/today_chip_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:text="@string/wellbeing_range_today" />

            <TextView
                android:id="@+id/tvRangeWeek"
                style="@style/TodayChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/today_chip_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:text="@string/wellbeing_range_week" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/todayContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvUsageNeeded"
            style="@style/TodayCardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/wellbeing_usage_needed"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Headline: distracting-app time today, with its caption underneath -->
        <LinearLayout
            android:id="@+id/llDistracting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvDistractingValue"
                style="@style/TodayCardStat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="4 h 7 min" />

            <TextView
                android:id="@+id/tvDistractingApps"
                style="@style/TodayCardBodyLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Distracting · 107 opens · top: YouTube 4 h 7 min" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llNudges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/tileWater"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/today_tile"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="72dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvWater"
                    style="@style/TodayCardStat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="29" />

                <TextView
                    android:id="@+id/tvWaterLabel"
                    style="@style/TodayCardLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nudge_water" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileWalk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/today_tile"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="72dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvWalk"
                    style="@style/TodayCardStat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="10" />

                <TextView
                    android:id="@+id/tvWalkLabel"
                    style="@style/TodayCardLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nudge_walk" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileNotNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/today_tile"
                android:minHeight="72dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvNotNow"
                    style="@style/TodayCardStat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="5" />

                <TextView
                    android:id="@+id/tvNotNowLabel"
                    style="@style/TodayCardLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/not_now" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvPauseWins"
            style="@style/TodayCardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            tools:text="Opened anyway 18 · mostly “Look something up”"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvHealth"
            style="@style/TodayCardBodyLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:text="6,240 steps · Slept 7 h 10"
            tools:visibility="visible" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/weekContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
