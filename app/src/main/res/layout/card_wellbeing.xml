<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llNudges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvWater"
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="4dp"
            android:visibility="gone"
            tools:text="Water 3"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvNudgeDivider"
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:paddingVertical="4dp"
            android:text="@string/wellbeing_separator"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvWalk"
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="4dp"
            android:visibility="gone"
            tools:text="Walk 1"
            tools:visibility="visible" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDistractingApps"
        style="@style/TextSmallLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingVertical="4dp"
        android:visibility="gone"
        tools:text="Distracting apps 38 min · 6 opens"
        tools:visibility="visible" />

</LinearLayout>
