<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvMarker"
        style="@style/TodayChip.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/today_chip_selectable"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingHorizontal="13dp"
        android:textColor="@drawable/text_colors_light"
        tools:text="Earlier turns summarised · see what it kept" />

    <!-- Read-only expander: the summary and the covered originals -->
    <LinearLayout
        android:id="@+id/markerBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/today_panel"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvSummaryHeading"
            style="@style/TodayCardLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chat_marker_summary_heading" />

        <TextView
            android:id="@+id/tvSummaryText"
            style="@style/TodayCardBodyLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.15"
            tools:text="The learner asked about stellen vs stehen, and the replies established that Wohin? takes the accusative." />

        <LinearLayout
            android:id="@+id/originalsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

    </LinearLayout>

</LinearLayout>
