<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/today_panel"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <View
        android:id="@+id/weatherSky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="3dp"
        android:importantForAccessibility="no" />

    <app.olauncher.ui.today.cards.WeatherRainView
        android:id="@+id/weatherRain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="3dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/llWeatherContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Shown when weather is on but no forecast has arrived yet -->
        <TextView
            android:id="@+id/tvUnavailable"
            style="@style/TodayCardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="@string/weather_unavailable_hint"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llForecast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    app:tint="?attr/primaryColor"
                    tools:src="@drawable/ic_weather_light_rain" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTemp"
                        style="@style/TodayCardStat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_weather"
                        tools:text="11°" />

                    <TextView
                        android:id="@+id/tvLine1"
                        style="@style/TodayCardBodyLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Overcast · 12° / 7°" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLine2"
                        style="@style/TodayCardBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        tools:text="Dry for 12 h" />

                    <TextView
                        android:id="@+id/tvLine3"
                        style="@style/TodayCardBodyLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="2"
                        android:maxWidth="150dp"
                        android:textSize="@dimen/text_caption"
                        tools:text="Berlin · as of 14:05 · Open-Meteo" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/hourlyRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="6" />

            <app.olauncher.ui.today.cards.WeatherChartView
                android:id="@+id/weatherChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
