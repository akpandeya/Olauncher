<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/captureScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim">

    <!-- Full-screen reader (#591): the default capture UI. -->
    <LinearLayout
        android:id="@+id/readerRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/readerTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/readerClose"
                style="@style/TextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="@string/reader_close"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/readerTitle"
                style="@style/TextLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/reader_title"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/readerSaveButton"
                style="@style/TextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingHorizontal="10dp"
                android:textColor="?attr/primaryColor" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/readerScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/readerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp" />
        </ScrollView>

        <TextView
            android:id="@+id/readerMeaningLine"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:textColor="?attr/primaryColor"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Circle-to-Search overlay (#592): the frozen frame with tap/circle word picking. -->
    <LinearLayout
        android:id="@+id/overlayRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/overlayTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/overlayClose"
                style="@style/TextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="@string/reader_close"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/overlayHint"
                style="@style/TextMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/capture_hint"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/overlaySaveCount"
                style="@style/TextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingHorizontal="10dp"
                android:textColor="?attr/primaryColor"
                android:visibility="gone" />

            <TextView
                android:id="@+id/overlayMenu"
                style="@style/TextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/capture_menu_desc"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="@string/capture_menu"
                android:textColor="?attr/primaryColor" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/overlayContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <app.olauncher.helper.CaptureOverlayView
                android:id="@+id/captureOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/overlayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/bg_popup_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/overlayCardWord"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/overlayCardMeaning"
                    style="@style/TextSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/primaryColor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/overlayCardReader"
                        style="@style/TextMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/capture_reader_view"
                        android:textColor="?attr/primaryColor" />

                    <TextView
                        android:id="@+id/overlayCardSave"
                        style="@style/TextMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:paddingHorizontal="10dp"
                        android:textColor="?attr/primaryColor" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom sheet kept for the list picker (shared text that classifies as a list). -->
    <LinearLayout
        android:id="@+id/captureSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:clickable="true"
        android:contentDescription="@string/a11y_word_capture_sheet"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selectAll"
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:text="@string/word_picker_select_all"
            android:textColor="?attr/primaryColor"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/wordsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <app.olauncher.helper.FlowLayout
                android:id="@+id/wordsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <TextView
            android:id="@+id/meaningLine"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="10dp"
            android:textColor="?attr/primaryColor"
            android:visibility="gone" />

        <TextView
            android:id="@+id/saveButton"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:textColor="?attr/primaryColor"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
