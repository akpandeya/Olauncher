<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/captureScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim">

    <LinearLayout
        android:id="@+id/captureSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:clickable="true"
        android:contentDescription="@string/a11y_word_capture_sheet"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/selectAll"
            style="@style/TextMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:text="@string/word_picker_select_all"
            android:textColor="?attr/primaryColor"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/wordsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <app.olauncher.helper.FlowLayout
                android:id="@+id/wordsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <TextView
            android:id="@+id/meaningLine"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="10dp"
            android:textColor="?attr/primaryColor"
            android:visibility="gone" />

        <TextView
            android:id="@+id/saveButton"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:textColor="?attr/primaryColor"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
