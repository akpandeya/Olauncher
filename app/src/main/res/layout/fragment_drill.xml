<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/todayScrimColor"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    tools:context=".ui.words.DrillFragment">

    <!-- Pinned top section: Quiz progress OR Summary counts header -->
    <LinearLayout
        android:id="@+id/drillHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="8dp">

        <!-- Quiz header: title, progress, segment bar -->
        <LinearLayout
            android:id="@+id/quizContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/TodayCardLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Prepositions" />

                <TextView
                    android:id="@+id/tvProgress"
                    style="@style/TodayCardBodyLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    tools:text="Multiple choice · 1 of 40" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/segmentRow"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />

        </LinearLayout>

        <!-- Pinned Summary Header -->
        <LinearLayout
            android:id="@+id/summaryHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvSummaryTitle"
                style="@style/TodayCardLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Prepositions" />

            <TextView
                android:id="@+id/tvSummaryCounts"
                style="@style/TodayCardBodyBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                tools:text="7 right · 1 almost · 2 wrong" />

        </LinearLayout>

        <!-- Empty state if no items exist -->
        <TextView
            android:id="@+id/tvEmpty"
            style="@style/TodayCardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/drill_empty_state"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Scrollable middle body -->
    <ScrollView
        android:id="@+id/drillScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp">

            <!-- Question card: lives inside the scroll view so long question content
                 (an 8-tile word-order bank, larger font scales) can never be clipped;
                 the header above and the buttons in the footer below stay pinned. -->
            <LinearLayout
                android:id="@+id/questionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/today_panel"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="24dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/quizCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Help slot (#651): opens above the prompt, grows upward, capped at
                         about 40% of the body height — the prompt and the answer tiles
                         below it never move, whether the slot is open or closed. -->
                    <app.olauncher.ui.words.DrillHelpCardView
                        android:id="@+id/helpScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:scrollbars="none"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:id="@+id/helpContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/helpChips"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />

                            <TextView
                                android:id="@+id/tvHelpRule"
                                style="@style/TodayCardBody"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                tools:text="A relative pronoun points back to a noun." />

                            <GridLayout
                                android:id="@+id/helpTable"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp" />

                            <TextView
                                android:id="@+id/tvHelpExample"
                                style="@style/TodayCardBodyLight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:textStyle="italic"
                                tools:text="Das Kind, das dort spielt, ist fünf Jahre alt." />

                            <TextView
                                android:id="@+id/tvHelpMiss"
                                style="@style/TodayCardBody"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                tools:text="✗ dem — the dative is for a fixed position (Wo?)." />

                        </LinearLayout>

                    </app.olauncher.ui.words.DrillHelpCardView>

                    <TextView
                        android:id="@+id/tvPrompt"
                        style="@style/TodayCardStat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Ich gehe durch ___ Park." />

                    <LinearLayout
                        android:id="@+id/hintRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvHint"
                            style="@style/TodayCardBodyLight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:visibility="gone"
                            tools:text="durch + Akkusativ"
                            tools:visibility="visible" />

                        <!-- The "Why?" button (design §2): opens the full help card before
                             an answer; the tap counts as a weaker right answer. -->
                        <TextView
                            android:id="@+id/btnWhy"
                            style="@style/TodayChip.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/today_chip_selectable"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="40dp"
                            android:paddingHorizontal="16dp"
                            android:text="@string/drill_help_why"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Choice round view -->
                <ScrollView
                    android:id="@+id/choiceScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <GridLayout
                        android:id="@+id/choiceGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2" />

                </ScrollView>

                <!-- Typed round view -->
                <LinearLayout
                    android:id="@+id/typedContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <EditText
                        android:id="@+id/etAnswer"
                        style="@style/TodayCardBodyBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/quiz_choice"
                        android:gravity="center"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="text|textNoSuggestions"
                        android:maxLines="1"
                        android:minHeight="@dimen/quiz_choice_min_height"
                        android:padding="@dimen/quiz_cell_padding"
                        android:shadowColor="@android:color/transparent" />

                </LinearLayout>

                <!-- Word order round view -->
                <app.olauncher.ui.words.WordOrderView
                    android:id="@+id/wordOrderView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvCorrection"
                    style="@style/TodayCardBodyBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="?attr/accentColor"
                    android:visibility="gone"
                    tools:text="den"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Summary card at end of quiz -->
            <LinearLayout
                android:id="@+id/quizCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/today_panel"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/summaryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Pinned footer: the primary button stays reachable above the keyboard -->
    <LinearLayout
        android:id="@+id/drillFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/btnPrimary"
            style="@style/TodayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/conjugation_check"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btnPractiseMisses"
            style="@style/TodayCardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/drill_summary_practise_misses"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btnSecondary"
            style="@style/TodayCardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/drill_summary_done"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
