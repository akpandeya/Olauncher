<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    tools:context=".ui.HomeFragment">

    <!-- Placeholder layout for locking screen-->
    <FrameLayout
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/lock_layout_description" />

    <!-- Home button for recents feature disabled -->
    <!-- Placeholder layout for showing recent apps
    <FrameLayout
        android:id="@+id/recents"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/recents_layout_description" /> -->

    <!-- Soft dark wash behind the top text; shown only when light text needs it (HomeWash) -->
    <View
        android:id="@+id/homeWash"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/home_top_wash"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Animated weather over the wallpaper; shown only with Weather effects on (HomeFragment) -->
    <app.olauncher.ui.WeatherEffectView
        android:id="@+id/weatherEffects"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Slow album-colour glow behind the clock while music plays (HomeFragment) -->
    <View
        android:id="@+id/musicGlow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/music_glow_height"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Clock and calendar-->
    <LinearLayout
        android:id="@+id/dateTimeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="56dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextClock
            android:id="@+id/clock"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            style="@style/TextDisplay"
            android:textColor="@drawable/text_colors_accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:maxLines="1"
            android:lastBaselineToBottomHeight="6dp"
            android:textSize="@dimen/time_size"
            tools:text="23:59" />

        <TextView
            android:id="@+id/clockWords"
            style="@style/TextDisplay"
            android:textColor="@drawable/text_colors_accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textSize="@dimen/time_words_size"
            android:visibility="gone"
            tools:text="Viertel nach drei" />

        <!-- Date and weather; weather moves under the date when both do not fit (HomeMetaLine) -->
        <LinearLayout
            android:id="@+id/dateWeatherRow"
            android:layout_marginTop="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/date"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                style="@style/TextLabel"
                android:textColor="@drawable/text_colors_accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, dd MMM"
                android:format24Hour="EEE, dd MMM"
                android:maxLines="2"
                android:paddingHorizontal="3dp"
                android:textSize="@dimen/home_meta_size"
                tools:text="Tue, 20 Oct" />

            <TextView
                android:id="@+id/weatherSeparator"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="·"
                android:textSize="@dimen/home_meta_size"
                android:visibility="gone"
                tools:ignore="HardcodedText"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/weather"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingHorizontal="3dp"
                android:textSize="@dimen/home_meta_size"
                android:visibility="gone"
                tools:text="🌦 12°" />
        </LinearLayout>

        <TextView
            android:id="@+id/nextEventLine"
            android:accessibilityLiveRegion="polite"
            android:letterSpacing="0.02"
            android:textColor="@drawable/text_colors_light"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:minHeight="@dimen/home_info_min_height"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="3dp"
            android:textSize="@dimen/date_size"
            android:visibility="gone"
            tools:text="14:30 · Standup"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/noteRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/noteLine"
                android:accessibilityLiveRegion="polite"
                android:letterSpacing="0.02"
                android:textColor="@drawable/text_colors_light"
                android:gravity="center_vertical"
                android:minHeight="@dimen/home_info_min_height"
                style="@style/TextDefault"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="3dp"
                android:textSize="@dimen/date_size"
                tools:text="→ call Mama back" />

            <TextView
                android:id="@+id/noteMore"
                android:letterSpacing="0.02"
                android:textColor="@drawable/text_colors_light"
                android:gravity="center_vertical"
                android:minHeight="@dimen/home_info_min_height"
                style="@style/TextDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingHorizontal="3dp"
                android:textSize="@dimen/date_size"
                android:visibility="gone"
                tools:text="+2 more"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/contextLine"
            android:accessibilityLiveRegion="polite"
            android:letterSpacing="0.02"
            android:textColor="@drawable/text_colors_light"
            android:gravity="center_vertical"
            android:minHeight="@dimen/home_info_min_height"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="3dp"
            android:textSize="@dimen/date_size"
            android:visibility="gone"
            tools:text="❚❚ Song — Artist"
            tools:visibility="visible" />

        <!-- Wavy progress line under the now-playing text while music plays (HomeFragment) -->
        <app.olauncher.ui.WavyProgressView
            android:id="@+id/mediaProgress"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginHorizontal="3dp"
            android:importantForAccessibility="yes"
            android:visibility="gone" />

        <TextView
            android:id="@+id/intentionLine"
            android:letterSpacing="0.01"
            android:textStyle="italic"
            android:layout_marginTop="4dp"
            android:textColor="@drawable/text_colors_light"
            style="@style/TextQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingHorizontal="3dp"
            android:textSize="@dimen/home_quote_size"
            android:visibility="gone"
            tools:text="finish the draft"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Screen time-->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvScreenTime"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="72dp"
        android:gravity="center"
        android:padding="10dp"
        android:textSize="@dimen/date_size"
        android:visibility="gone"
        tools:text="2h 11m"
        tools:visibility="visible" />

    <!-- Home apps-->
    <LinearLayout
        android:id="@+id/homeAppsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="112dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/homeApp1"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:hint="@string/app"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_1"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp2"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:hint="@string/app"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_2"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp3"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:hint="@string/app"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_3"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp4"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:hint="@string/app"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_4"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp5"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:hint="@string/app"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_5"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp6"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:hint="@string/app"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_6"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp7"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:hint="@string/app"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_7"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp8"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:hint="@string/app"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:tag="@string/tag_8"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Shortcut icons-->
    <LinearLayout
        android:id="@+id/shortcutsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/firstRunTips"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="56dp"
        android:text="@string/swipe_up_for_apps"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Set default launcher -->
    <TextView
        android:id="@+id/setDefaultLauncher"
        style="@style/TextMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="56dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/set_as_default_launcher_u"
        android:visibility="gone" />
</FrameLayout>