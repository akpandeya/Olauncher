<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp">

        <TextView
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:text="@string/note_add_title"
            android:textColor="?attr/ink" />
    </FrameLayout>

    <app.olauncher.ui.views.MaxHeightScrollView
        android:id="@+id/scrollNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etNoteTitle"
                style="@style/TodayCardBodyBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@null"
                android:cursorVisible="true"
                android:hint="@string/note_add_title_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:minHeight="48dp"
                android:shadowColor="@android:color/transparent"
                android:textColor="?attr/primaryColor"
                android:textColorHint="?attr/primaryColorTrans80" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etNoteBody"
                style="@style/TodayCardBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:cursorVisible="true"
                android:gravity="top"
                android:hint="@string/note_add_body_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="72dp"
                android:shadowColor="@android:color/transparent"
                android:textColor="?attr/primaryColor"
                android:textColorHint="?attr/primaryColorTrans80" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/today_panel"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TodayCardBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/note_add_checklist" />

                        <TextView
                            style="@style/TodayCardBodyLight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/note_add_checklist_sub" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchChecklist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/note_add_checklist"
                        android:minHeight="48dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowRemind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TodayCardBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/note_add_remind" />

                    <TextView
                        android:id="@+id/tvRemindDate"
                        style="@style/TodayChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/today_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="2dp"
                        android:text="@string/note_add_remind_none" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TodayCardBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/note_add_pin" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchPin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/note_add_pin"
                        android:minHeight="48dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvListsHeading"
                style="@style/TodayCardLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/note_add_lists"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/noteListChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="0dp" />

            <TextView
                style="@style/TodayCardBodyLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/note_add_hint" />
        </LinearLayout>
    </app.olauncher.ui.views.MaxHeightScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btnNoteCancel"
            style="@style/TodayCardBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:text="@string/cancel" />

        <TextView
            android:id="@+id/btnNoteSave"
            style="@style/TodayCardBodyBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:text="@string/save"
            android:textColor="?attr/accent" />
    </LinearLayout>
</LinearLayout>
