<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvCardTitle"
        style="@style/TextSmallLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:letterSpacing="0.04"
        tools:text="Notes · 4" />

    <EditText
        android:id="@+id/etSearchNotes"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="@string/notes_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="48dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNote"
            style="@style/TextSmallBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:ellipsize="end"
            android:focusable="true"
            android:maxLines="3"
            android:paddingTop="8dp"
            tools:text="Milk, eggs, bread" />

        <TextView
            android:id="@+id/tvNoteCount"
            style="@style/TextSmallLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingTop="8dp"
            android:visibility="gone"
            tools:text="1 of 3" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbNote"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:visibility="gone"
        tools:progress="33"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/itemsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tvNoteDate"
        style="@style/TextSmallLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:visibility="gone"
        tools:text="Fri 24 Oct · edited today" />

    <TextView
        android:id="@+id/tvMore1"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="6dp"
        android:visibility="gone"
        tools:text="· Call the landlord" />

    <TextView
        android:id="@+id/tvMore2"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="4dp"
        android:visibility="gone"
        tools:text="· Renew library card" />

    <View
        android:id="@+id/vNextDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:alpha="0.25"
        android:background="?attr/inkMuted"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvNextDated"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="8dp"
        android:visibility="gone"
        tools:text="Next: Mon 27 Oct · Call dentist" />

    <TextView
        android:id="@+id/btnAddNote"
        style="@style/TextSmallBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:gravity="center_vertical|end"
        android:minHeight="48dp"
        android:text="@string/notes_card_add"
        android:textColor="?attr/accent" />

</LinearLayout>
