<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/todayScrimColor"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    tools:context=".ui.words.GrammarRulesFragment">

    <!-- Pinned header: title, rule count and the search field -->
    <LinearLayout
        android:id="@+id/rulesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TodayCardLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/grammar_rules_title" />

            <TextView
                android:id="@+id/tvCount"
                style="@style/TodayCardBodyLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxLines="1"
                tools:text="106 rules" />

        </LinearLayout>

        <!-- Search: same pill shape as the Words screen's search -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="4dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etRuleSearch"
                style="@style/TextSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/grammar_rules_search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:minHeight="48dp"
                android:shadowRadius="0"
                android:textColorHint="?attr/primaryColorTrans50" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/words_search_clear"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- One line pointing out the groups' suggested learning order (#809) -->
        <TextView
            android:id="@+id/tvLearningOrder"
            style="@style/TodayCardBodyLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/grammar_rules_learning_order" />

    </LinearLayout>

    <!-- Scrolling body: the rules grouped by topic, in a suggested learning order -->
    <ScrollView
        android:id="@+id/rulesScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="48dp">

            <LinearLayout
                android:id="@+id/rulesPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/today_panel"
                android:orientation="vertical"
                android:padding="16dp" />

            <!-- No-match state of a search; the empty registry shows it too -->
            <TextView
                android:id="@+id/tvNoMatch"
                style="@style/TodayCardBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:visibility="gone"
                tools:text="No rule matches “xyz”"
                tools:visibility="visible" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
