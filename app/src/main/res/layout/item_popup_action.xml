<?xml version="1.0" encoding="utf-8"?>
<!-- One action row in the app long-press popup -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PopupCardRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical|start"
    android:minHeight="48dp"
    android:paddingStart="@dimen/popup_card_padding_horizontal"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/popup_card_padding_horizontal"
    android:paddingBottom="8dp"
    tools:text="@string/app_info" />
