<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/todayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/todayScrimColor"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    tools:context=".ui.today.TodayFragment">

    <ScrollView
        android:id="@+id/todayScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="56dp"
            android:paddingBottom="48dp">

            <!-- Greeting: weekday as the title, date under it -->
            <TextView
                android:id="@+id/tvHeroDay"
                style="@style/TextLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:textSize="@dimen/text_display"
                tools:text="Samstag" />

            <TextView
                android:id="@+id/tvHeroDate"
                style="@style/TextMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="4dp"
                tools:text="24. Oktober" />

            <!-- Intention card: label, the day's line, and a link to earlier days -->
            <LinearLayout
                android:id="@+id/intentionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/today_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextSmallLight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/intention_hint" />

                        <EditText
                            android:id="@+id/etIntention"
                            style="@style/TextSmallBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="@string/intention_field_hint"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences"
                            android:maxLength="60"
                            android:maxLines="1"
                            android:minHeight="48dp"
                            android:paddingVertical="8dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPastIntentions"
                        style="@style/TextSmallLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:paddingHorizontal="4dp"
                        android:text="@string/intention_past_header"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvPastIntentionsList"
                    style="@style/TextSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Cards that belong first right now (Next up while a meeting is on or later today) -->
            <LinearLayout
                android:id="@+id/pinnedCardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/heroWeatherHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/cardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/addWidget"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingHorizontal="4dp"
                android:text="@string/today_add_widget" />

        </LinearLayout>

    </ScrollView>

    <View
        android:id="@+id/statusBarFade"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@drawable/status_bar_fade"
        android:importantForAccessibility="no" />

</FrameLayout>
