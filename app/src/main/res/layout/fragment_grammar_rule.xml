<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/todayScrimColor"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    tools:context=".ui.words.GrammarRuleFragment">

    <!-- Pinned header: back to the rules index -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp">

        <TextView
            android:id="@+id/btnBack"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/words_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:text="@string/grammar_rule_back" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="48dp">

            <!-- The rule's full help card (#651 rendering, shared with the drill
                 screen's help slot through view_help_card + HelpCardViewBinder) -->
            <LinearLayout
                android:id="@+id/ruleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/today_panel"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="24dp">

                <TextView
                    android:id="@+id/tvRuleTitle"
                    style="@style/TodayCardLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Two-way prepositions" />

                <!-- The shared help-card body; the id exposes it as a
                     ViewHelpCardBinding field of this screen's binding. -->
                <include
                    android:id="@+id/helpCard"
                    layout="@layout/view_help_card" />

            </LinearLayout>

            <!-- The Ask-AI entry (docs/design/ask-ai-chat.md §Entry points): hidden
                 entirely when AI is unavailable, never greyed. -->
            <TextView
                android:id="@+id/askAiRow"
                style="@style/TextSmallBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/words_grade_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="@string/ask_ai_rule_row"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
