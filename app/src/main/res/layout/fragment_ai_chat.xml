<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/todayScrimColor"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    tools:context=".ui.words.AiChatFragment">

    <!-- Pinned header: subject line, close -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvSubject"
            style="@style/TodayCardBodyBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:singleLine="true"
            tools:text="Two-way prepositions" />

        <TextView
            android:id="@+id/btnClose"
            style="@style/TodayChip"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/today_tile"
            android:clickable="true"
            android:contentDescription="@string/chat_close"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/chat_close_glyph" />

    </LinearLayout>

    <!-- Collapsible grounding card: what the AI sees -->
    <LinearLayout
        android:id="@+id/groundingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/today_panel"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:id="@+id/groundingHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGroundingLabel"
                style="@style/TodayCardLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/chat_grounding_label" />

            <TextView
                android:id="@+id/tvGroundingChevron"
                style="@style/TodayCardBodyLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                tools:text="▾" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/groundingBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="6dp" />

    </LinearLayout>

    <!-- Messages list: assistant panels, user tiles right, compaction markers -->
    <ScrollView
        android:id="@+id/messagesScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/messagesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp" />

    </ScrollView>

    <!-- Usage line: muted, tap for detail -->
    <TextView
        android:id="@+id/tvUsage"
        style="@style/TodayCardBodyLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:minHeight="48dp"
        android:textSize="@dimen/today_label_size"
        android:visibility="gone"
        tools:text="≈ 1.8k tokens · 4 turns"
        tools:visibility="visible" />

    <!-- Pinned composer -->
    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingBottom="48dp">

        <EditText
            android:id="@+id/etQuestion"
            style="@style/TodayCardBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/quiz_choice"
            android:hint="@string/chat_composer_hint"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:textColorHint="@drawable/text_colors_light" />

        <TextView
            android:id="@+id/btnSend"
            style="@style/TodayButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:contentDescription="@string/chat_send"
            android:focusable="true"
            android:paddingHorizontal="0dp"
            android:text="@string/chat_send_glyph" />

    </LinearLayout>

</LinearLayout>
