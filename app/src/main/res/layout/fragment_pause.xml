<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pauseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.pause.PauseFragment">

    <LinearLayout
        android:id="@+id/pauseContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/appName"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            tools:text="Instagram" />

        <TextView
            android:id="@+id/usageStats"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="2dp"
            android:textColor="?attr/primaryColorTrans80"
            tools:text="Opened 4 times today · 38 min" />

        <TextView
            android:id="@+id/overAllowance"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="2dp"
            android:textColor="?attr/primaryColorTrans80"
            android:visibility="gone"
            tools:text="Over today's 30 min allowance"
            tools:visibility="visible" />

        <include
            android:id="@+id/wordReveal"
            layout="@layout/view_word_reveal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/notice"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingBottom="16dp"
            android:text="@string/pause_notification_notice"
            android:textColor="?attr/primaryColorTrans80" />

        <LinearLayout
            android:id="@+id/whyChoicesContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/choiceReply"
                style="@style/TextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="6dp"
                android:text="@string/pause_why_reply" />

            <TextView
                android:id="@+id/choiceLookup"
                style="@style/TextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="6dp"
                android:text="@string/pause_why_lookup" />

            <TextView
                android:id="@+id/choiceBored"
                style="@style/TextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="6dp"
                android:text="@string/pause_why_bored" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnOpenContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnOpen"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="@dimen/home_app_padding_vertical"
                tools:text="Open (5)" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnNotNow"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="@dimen/home_app_padding_vertical"
            android:text="@string/not_now" />

    </LinearLayout>

</FrameLayout>
