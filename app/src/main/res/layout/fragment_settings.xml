<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainActivityLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="@dimen/settings_scroll_margin_vertical"
        android:fadingEdgeLength="@dimen/settings_fading_edge"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/settings_scroll_padding_horizontal"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/scrollLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="@dimen/settings_content_padding_vertical">

            <LinearLayout
                android:id="@+id/settingsBackLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/readable_card"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/settingsBack"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/settings_back"
                    android:textColor="?attr/primaryColor" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/thumblineHeaderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/readable_card"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/olauncherHiddenApps"
                        style="@style/TextLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/app_name" />

                    <ImageView
                        android:id="@+id/appInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:contentDescription="@string/app_info"
                        android:padding="4dp"
                        android:src="@drawable/ic_info" />
                </FrameLayout>

                <TextView
                    android:id="@+id/setLauncher"
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/set_as_default_launcher" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionListLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/readable_card"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/sectionRowHome"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/home_screen"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/sectionRowShortcuts"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/shortcut_icons"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/sectionRowDrawer"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/drawer"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/sectionRowWellbeing"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/wellbeing"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/sectionRowToday"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/today_section"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/sectionRowDeutsch"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/deutsch_de"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/sectionRowAppearance"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/appearance"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/sectionRowGestures"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/gestures"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/sectionRowBackup"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/backup"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:tag="sectionRowPrivacy"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/privacy"
                    android:textColor="?attr/primaryColor" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/settingsRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/readable_card"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingHorizontal="12dp"
                android:paddingVertical="16dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/footer"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:padding="12dp" />

            <TextView
                android:id="@+id/licenseNote"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:gravity="center"
                android:linksClickable="true"
                android:paddingHorizontal="12dp"
                android:paddingBottom="12dp"
                android:text="@string/wiktionary_license_note"
                android:textSize="@dimen/text_subtitle" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/settingsSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/readable_card"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/settingsSearch"
            style="@style/TextLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="@string/search_settings"
            android:imeOptions="actionDone"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:textColor="?attr/primaryColor"
            android:textColorHint="?attr/primaryColorTrans80" />
    </LinearLayout>

    <View
        android:id="@+id/statusBarFade"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@drawable/status_bar_fade"
        android:importantForAccessibility="no" />

</FrameLayout>
