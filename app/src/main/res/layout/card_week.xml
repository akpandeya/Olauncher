<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvWeekTotal"
        style="@style/TextLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_stat"
        android:textStyle="bold"
        tools:text="20 h 5 min" />

    <TextView
        android:id="@+id/tvWeekCaption"
        style="@style/TextSmallLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wellbeing_week_caption" />

    <TextView
        android:id="@+id/tvWeekChange"
        style="@style/TextSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="20% less than the week before" />

    <app.olauncher.ui.today.cards.DayBarsView
        android:id="@+id/dayBars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvWeekAllowance"
        style="@style/TextSmallLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        tools:text="Over allowance on 2 of 7 days"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvTopAppsTitle"
        style="@style/TextSmallLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/wellbeing_week_top_apps" />

    <LinearLayout
        android:id="@+id/llTopApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/today_tile"
            android:minHeight="96dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/TextSmallLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_now" />

            <TextView
                android:id="@+id/tvWeekNotNow"
                style="@style/TextLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                tools:text="31" />

            <TextView
                android:id="@+id/tvWeekNotNowSub"
                style="@style/TextSmallLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Opened anyway 15 · mostly “Just bored”" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/today_tile"
            android:minHeight="96dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/TextSmallLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wellbeing_week_water_walk" />

            <TextView
                android:id="@+id/tvWeekWaterWalk"
                style="@style/TextLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                tools:text="34 · 12" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
