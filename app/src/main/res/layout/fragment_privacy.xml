<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/todayScrimColor"
    android:clickable="true"
    android:fadingEdgeLength="32dp"
    android:focusable="true"
    android:importantForAccessibility="no"
    android:overScrollMode="never"
    android:requiresFadingEdge="vertical"
    android:scrollbars="none"
    tools:context=".ui.privacy.PrivacyFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy" />

        <TextView
            android:id="@+id/tvIntro"
            style="@style/TextSmallLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingBottom="12dp"
            android:text="@string/privacy_intro" />

        <LinearLayout
            android:id="@+id/privacyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/today_panel"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />

    </LinearLayout>
</ScrollView>
