<?xml version="1.0" encoding="utf-8"?>
<!-- The one shared summary row (#623, owner decision 2026-10-28): both the drill
     round summary and the review summary inflate this layout — same mark slot,
     same text styles — and each fragment keeps its own thin adapter that maps
     its row model onto it. Do not fork per-feature copies of this file. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/SummaryRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/ivMark"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_check"
        tools:tint="@color/accentSage" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPrimary"
            style="@style/TodayCardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Ich gehe durch ___ Park. (dem)" />

        <TextView
            android:id="@+id/tvSecondary"
            style="@style/TodayCardBodyLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            tools:text="den · durch + Akkusativ"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
