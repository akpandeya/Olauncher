<?xml version="1.0" encoding="utf-8"?>
<!-- The one shared summary row (#623, owner decision 2026-10-28): both the drill
     round summary and the review summary inflate this layout — same mark slot,
     same text styles — and each fragment keeps its own thin adapter that maps
     its row model onto it. Do not fork per-feature copies of this file. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/SummaryRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/ivMark"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_check"
        tools:tint="@color/accentSage" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPrimary"
            style="@style/TodayCardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Ich gehe durch ___ Park. (dem)" />

        <TextView
            android:id="@+id/tvSecondary"
            style="@style/TodayCardBodyLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            tools:text="den · durch + Akkusativ"
            tools:visibility="visible" />

        <!-- The Ask-AI chip (docs/design/ask-ai-chat.md §Entry points): wrong and
             almost rows only, hidden when AI is unavailable — never greyed. Tap
             opens the subject's latest thread; long-press opens the thread sheet.
             Bound per row by each fragment's thin adapter. -->
        <TextView
            android:id="@+id/tvAskAi"
            style="@style/TodayChip.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/today_chip_selectable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingHorizontal="16dp"
            android:text="@string/ask_ai_chip"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
