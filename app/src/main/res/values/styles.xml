<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.Thumbline.Base" />

    <!-- Applied over AppTheme when bold font is enabled -->
    <style name="BoldFontOverlay">
        <item name="mainFontFamily">sans-serif</item>
    </style>

    <!-- Font family overlays applied over AppTheme -->
    <style name="FontInterOverlay">
        <item name="mainFontFamily">@font/inter</item>
        <item name="displayFontFamily">@font/inter_bold</item>
        <item name="labelFontFamily">@font/inter</item>
        <item name="quoteFontFamily">@font/inter</item>
    </style>

    <style name="FontInterBoldOverlay">
        <item name="mainFontFamily">@font/inter_bold</item>
        <item name="displayFontFamily">@font/inter_bold</item>
        <item name="labelFontFamily">@font/inter_bold</item>
        <item name="quoteFontFamily">@font/inter_bold</item>
    </style>

    <style name="FontPlexOverlay">
        <item name="mainFontFamily">@font/ibm_plex_sans</item>
        <item name="displayFontFamily">@font/ibm_plex_sans_bold</item>
        <item name="labelFontFamily">@font/ibm_plex_sans</item>
        <item name="quoteFontFamily">@font/ibm_plex_sans</item>
    </style>

    <style name="FontPlexBoldOverlay">
        <item name="mainFontFamily">@font/ibm_plex_sans_bold</item>
        <item name="displayFontFamily">@font/ibm_plex_sans_bold</item>
        <item name="labelFontFamily">@font/ibm_plex_sans_bold</item>
        <item name="quoteFontFamily">@font/ibm_plex_sans_bold</item>
    </style>

    <!-- Accent theme overlays applied over AppTheme -->
    <style name="AccentSystemOverlay">
        <item name="accentColor">@color/accentSystem</item>
        <item name="accent">@color/accentSystem</item>
    </style>

    <style name="AccentSageOverlay">
        <item name="accentColor">@color/accentSage</item>
        <item name="accent">@color/accentSage</item>
    </style>

    <style name="AccentSandOverlay">
        <item name="accentColor">@color/accentSand</item>
        <item name="accent">@color/accentSand</item>
    </style>

    <style name="AccentSkyOverlay">
        <item name="accentColor">@color/accentSky</item>
        <item name="accent">@color/accentSky</item>
    </style>

    <style name="AccentRoseOverlay">
        <item name="accentColor">@color/accentRose</item>
        <item name="accent">@color/accentRose</item>
    </style>

    <style name="WindowAnimationTransition">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="AppSearchText" parent="Widget.AppCompat.SearchView">
        <item name="android:maxLength">200</item>
        <item name="android:textSize">@dimen/text_large</item>
        <item name="android:textColor">?attr/primaryColor</item>
        <item name="android:editTextColor">?attr/primaryColor</item>
        <item name="android:textColorHint">?attr/primaryColor</item>
        <item name="android:fontFamily">?attr/mainFontFamily</item>
        <item name="android:inputType">textCapSentences|textNoSuggestions</item>
        <item name="android:cursorVisible">false</item>
    </style>

    <style name="TextDefault" parent="@android:style/TextAppearance.Large">
        <item name="android:textColor">@drawable/text_colors_default</item>
        <item name="android:textColorHint">?attr/primaryColorTrans80</item>
        <item name="android:shadowColor">?attr/primaryTextShadowColor</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">6</item>
    </style>

    <!-- Home type roles; fonts follow the font setting through the theme attributes -->
    <style name="TextDisplay" parent="TextDefault">
        <item name="android:fontFamily">?attr/displayFontFamily</item>
    </style>

    <style name="TextLabel" parent="TextDefault">
        <item name="android:fontFamily">?attr/labelFontFamily</item>
    </style>

    <style name="TextQuote" parent="TextDefault">
        <item name="android:fontFamily">?attr/quoteFontFamily</item>
        <item name="android:textStyle">italic</item>
    </style>

    <style name="TextLarge" parent="TextDefault">
        <item name="android:fontFamily">?attr/mainFontFamily</item>
        <item name="android:textSize">@dimen/text_large</item>
    </style>

    <style name="TextMedium" parent="TextDefault">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextSmall" parent="TextDefault">
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <!-- Hint under a settings section row. Not focusable and hidden from TalkBack; the row above carries the label. -->
    <style name="SettingsSectionHint" parent="TextSmall">
        <item name="android:alpha">0.7</item>
        <item name="android:textColor">?attr/primaryColor</item>
        <item name="android:focusable">false</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="TextSmallBold" parent="TextSmall">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Value text on the right of a settings row; plain primary colour; accent is for clock, date and highlights -->
    <style name="TextSettingsValue" parent="TextSmallBold">
        <item name="android:textColor">@drawable/text_colors_default</item>
    </style>

    <style name="TextSmallLight" parent="TextSmall">
        <item name="android:textColor">@drawable/text_colors_light</item>
    </style>

    <!-- Popup menu anchored to a settings row -->
    <style name="OlPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/rounded_primary_gradient</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="OlPopupMenu.NoAnimation">
        <item name="android:popupAnimationStyle">@style/NoWindowAnimation</item>
    </style>

    <style name="OlPopupMenuText" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">?attr/primaryColor</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Alert dialogs: the window only; content comes from layout/dialog_base.xml -->
    <!-- App long-press popup card (showAppActionPopup) -->
    <style name="PopupCardHeading" parent="TextSmallLight">
        <item name="android:fontFamily">?attr/mainFontFamily</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">?attr/inkMuted</item>
        <item name="android:shadowRadius">0</item>
    </style>

    <style name="PopupCardRow" parent="TextSmall">
        <item name="android:fontFamily">?attr/mainFontFamily</item>
        <item name="android:shadowRadius">0</item>
    </style>

    <style name="PopupCardAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/popup_card_enter</item>
        <item name="android:windowExitAnimation">@anim/popup_card_exit</item>
    </style>

    <style name="OlAlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowAnimationStyle">@style/OlDialogAnimation</item>
    </style>

    <style name="OlDialogAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="OlAlertDialog.NoAnimation">
        <item name="android:windowAnimationStyle">@style/NoWindowAnimation</item>
    </style>

    <!-- Applied over AppTheme on e-ink displays or when system animations are off -->
    <style name="NoAnimationOverlay">
        <item name="popupMenuStyle">@style/OlPopupMenu.NoAnimation</item>
        <item name="alertDialogTheme">@style/OlAlertDialog.NoAnimation</item>
        <item name="popupCardAnimationStyle">@style/NoWindowAnimation</item>
    </style>

    <style name="NoWindowAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <style name="Theme.WordCapture" parent="AppTheme">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
