<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="app.olauncher.ui.HomeFragment"
        android:label="main_fragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_mainFragment_to_appListFragment"
            app:destination="@id/appListFragment"
            app:enterAnim="@animator/drawer_enter"
            app:popExitAnim="@animator/drawer_exit" />
        <action
            android:id="@+id/action_mainFragment_to_settingsFragment"
            app:destination="@id/settingsFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
        <action
            android:id="@+id/action_mainFragment_to_pauseFragment"
            app:destination="@id/pauseFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
        <action
            android:id="@+id/action_mainFragment_to_todayFragment"
            app:destination="@id/todayFragment"
            app:enterAnim="@animator/today_enter"
            app:popExitAnim="@animator/today_exit" />
    </fragment>

    <fragment
        android:id="@+id/appListFragment"
        android:name="app.olauncher.ui.AppDrawerFragment"
        android:label="app_list_fragment"
        tools:layout="@layout/fragment_app_drawer">
        <action
            android:id="@+id/action_appListFragment_to_settingsFragment2"
            app:destination="@id/settingsFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit"
            app:popUpTo="@+id/appListFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_appListFragment_to_pauseFragment"
            app:destination="@id/pauseFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit"
            app:popUpTo="@+id/appListFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_appListFragment_to_conjugationFragment"
            app:destination="@id/conjugationFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="app.olauncher.ui.SettingsFragment"
        android:label="SettingsFragment"
        android:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_appListFragment"
            app:destination="@id/appListFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
        <action
            android:id="@+id/action_settingsFragment_to_privacyFragment"
            app:destination="@id/privacyFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
        <action
            android:id="@+id/action_settingsFragment_to_germanSetupFragment"
            app:destination="@id/germanSetupFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
    </fragment>

    <fragment
        android:id="@+id/pauseFragment"
        android:name="app.olauncher.ui.pause.PauseFragment"
        android:label="PauseFragment"
        tools:layout="@layout/fragment_pause">
        <argument
            android:name="package"
            app:argType="string" />
        <argument
            android:name="class"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="user"
            app:argType="string" />
        <argument
            android:name="label"
            app:argType="string" />
        <argument
            android:name="shortcutId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/todayFragment"
        android:name="app.olauncher.ui.today.TodayFragment"
        android:label="TodayFragment"
        tools:layout="@layout/fragment_today">
        <action
            android:id="@+id/action_todayFragment_to_wordsFragment"
            app:destination="@id/wordsFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
        <action
            android:id="@+id/action_todayFragment_to_wordListsFragment"
            app:destination="@id/wordListsFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
        <action
            android:id="@+id/action_todayFragment_to_reviewFragment"
            app:destination="@id/reviewFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
        <action
            android:id="@+id/action_todayFragment_to_appListFragment"
            app:destination="@id/appListFragment"
            app:enterAnim="@animator/drawer_enter"
            app:popExitAnim="@animator/drawer_exit" />
        <action
            android:id="@+id/action_todayFragment_to_notesFragment"
            app:destination="@id/notesFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
    </fragment>

    <fragment
        android:id="@+id/notesFragment"
        android:name="app.olauncher.ui.notes.NotesFragment"
        android:label="NotesFragment"
        tools:layout="@layout/fragment_notes">
        <action
            android:id="@+id/action_notesFragment_to_noteViewFragment"
            app:destination="@id/noteViewFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
    </fragment>

    <fragment
        android:id="@+id/noteViewFragment"
        android:name="app.olauncher.ui.notes.NoteViewFragment"
        android:label="NoteViewFragment"
        tools:layout="@layout/fragment_note_view" />

    <fragment
        android:id="@+id/wordsFragment"
        android:name="app.olauncher.ui.words.WordsFragment"
        android:label="WordsFragment"
        tools:layout="@layout/fragment_words">
        <action
            android:id="@+id/action_wordsFragment_to_reviewFragment"
            app:destination="@id/reviewFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
        <action
            android:id="@+id/action_wordsFragment_to_wordListsFragment"
            app:destination="@id/wordListsFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
        <action
            android:id="@+id/action_wordsFragment_to_conjugationFragment"
            app:destination="@id/conjugationFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
    </fragment>

    <fragment
        android:id="@+id/wordListsFragment"
        android:name="app.olauncher.ui.words.WordListsFragment"
        android:label="WordListsFragment"
        tools:layout="@layout/fragment_word_lists">
        <action
            android:id="@+id/action_wordListsFragment_to_wordListFragment"
            app:destination="@id/wordListFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
        <action
            android:id="@+id/action_wordListsFragment_to_wordsFragment"
            app:destination="@id/wordsFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit"
            app:popUpTo="@id/wordsFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/wordListFragment"
        android:name="app.olauncher.ui.words.WordListFragment"
        android:label="WordListFragment"
        tools:layout="@layout/fragment_word_list">
        <argument
            android:name="listId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="sourceBucket"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_wordListFragment_to_conjugationFragment"
            app:destination="@id/conjugationFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit" />
    </fragment>

    <fragment
        android:id="@+id/reviewFragment"
        android:name="app.olauncher.ui.words.ReviewFragment"
        android:label="ReviewFragment"
        tools:layout="@layout/fragment_review">
        <action
            android:id="@+id/action_reviewFragment_to_wordsFragment"
            app:destination="@id/wordsFragment"
            app:enterAnim="@animator/fade_enter"
            app:exitAnim="@animator/fade_exit"
            app:popEnterAnim="@animator/fade_enter"
            app:popExitAnim="@animator/fade_exit"
            app:popUpTo="@id/reviewFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/conjugationFragment"
        android:name="app.olauncher.ui.words.ConjugationFragment"
        android:label="ConjugationFragment"
        tools:layout="@layout/fragment_conjugation">
        <argument
            android:name="word"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/privacyFragment"
        android:name="app.olauncher.ui.privacy.PrivacyFragment"
        android:label="PrivacyFragment"
        tools:layout="@layout/fragment_privacy" />

    <fragment
        android:id="@+id/germanSetupFragment"
        android:name="app.olauncher.ui.german.GermanSetupFragment"
        android:label="GermanSetupFragment"
        tools:layout="@layout/fragment_german_setup" />

</navigation>