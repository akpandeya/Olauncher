<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group android:translateX="12" android:translateY="12" android:scaleX="1" android:scaleY="1">
        <group android:translateX="-12" android:translateY="-12">
            <!-- Glow -->
            <path android:pathData="M 12,0.4 A 11.6,11.6 0 1,0 12,23.6 A 11.6,11.6 0 1,0 12,0.4 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="radial"
                        android:centerX="12"
                        android:centerY="12"
                        android:gradientRadius="11.6">
                        <item android:offset="0.0" android:color="@color/weatherGlowTrans60" />
                        <item android:offset="0.55" android:color="@color/weatherGlowTrans18" />
                        <item android:offset="1.0" android:color="@color/weatherGlowClear" />
                    </gradient>
                </aapt:attr>
            </path>
            <!-- Rays -->
            <group android:pivotX="12" android:pivotY="12" android:rotation="0">
                <path android:pathData="M 10.6,5.2 L 13.4,5.2 L 12,1.4 Z" android:fillColor="@color/weatherRay" />
            </group>
            <group android:pivotX="12" android:pivotY="12" android:rotation="45">
                <path android:pathData="M 10.6,5.2 L 13.4,5.2 L 12,1.4 Z" android:fillColor="@color/weatherRay" />
            </group>
            <group android:pivotX="12" android:pivotY="12" android:rotation="90">
                <path android:pathData="M 10.6,5.2 L 13.4,5.2 L 12,1.4 Z" android:fillColor="@color/weatherRay" />
            </group>
            <group android:pivotX="12" android:pivotY="12" android:rotation="135">
                <path android:pathData="M 10.6,5.2 L 13.4,5.2 L 12,1.4 Z" android:fillColor="@color/weatherRay" />
            </group>
            <group android:pivotX="12" android:pivotY="12" android:rotation="180">
                <path android:pathData="M 10.6,5.2 L 13.4,5.2 L 12,1.4 Z" android:fillColor="@color/weatherRay" />
            </group>
            <group android:pivotX="12" android:pivotY="12" android:rotation="225">
                <path android:pathData="M 10.6,5.2 L 13.4,5.2 L 12,1.4 Z" android:fillColor="@color/weatherRay" />
            </group>
            <group android:pivotX="12" android:pivotY="12" android:rotation="270">
                <path android:pathData="M 10.6,5.2 L 13.4,5.2 L 12,1.4 Z" android:fillColor="@color/weatherRay" />
            </group>
            <group android:pivotX="12" android:pivotY="12" android:rotation="315">
                <path android:pathData="M 10.6,5.2 L 13.4,5.2 L 12,1.4 Z" android:fillColor="@color/weatherRay" />
            </group>
            <!-- Sun disk -->
            <path android:pathData="M 12,6.7 A 5.3,5.3 0 1,0 12,17.3 A 5.3,5.3 0 1,0 12,6.7 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="radial"
                        android:centerX="10.41"
                        android:centerY="9.88"
                        android:gradientRadius="8.48"
                        android:startColor="@color/weatherSunHi"
                        android:endColor="@color/weatherSunLo" />
                </aapt:attr>
            </path>
            <!-- Highlight -->
            <path
                android:pathData="M 10.6,9.4 A 1.7,1 0 1,0 10.6,11.4 A 1.7,1 0 1,0 10.6,9.4 Z"
                android:fillColor="@color/white"
                android:fillAlpha="0.45" />
        </group>
    </group>
</vector>
