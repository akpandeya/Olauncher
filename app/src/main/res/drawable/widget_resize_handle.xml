<?xml version="1.0" encoding="utf-8"?>
<!-- Grab bar centered in the full-width drag strip at the bottom edge of a widget card
     while it is being resized. The translucent dark halo keeps the accent pill readable
     on any wallpaper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="120dp"
        android:height="28dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/scrimHandle" />
            <corners android:radius="@dimen/radiusPill" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="8dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="?attr/accentColor" />
            <corners android:radius="@dimen/radiusPill" />
        </shape>
    </item>
</layer-list>
