<?xml version="1.0" encoding="utf-8"?>
<!-- Grab pill shown at the bottom edge of a widget card while it is being resized.
     The translucent dark halo keeps the accent pill readable on any wallpaper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="44dp"
        android:height="10dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <corners android:radius="@dimen/radiusPill" />
        </shape>
    </item>
    <item
        android:width="36dp"
        android:height="4dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="?attr/accentColor" />
            <corners android:radius="@dimen/radiusPill" />
        </shape>
    </item>
</layer-list>
