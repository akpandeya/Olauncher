<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/primaryColorTrans50">
    <item>
        <layer-list>
            <!-- Outer ambient shadow -->
            <item
                android:top="2dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/todayTileShadowSoft" />
                    <corners android:radius="@dimen/radiusSmall" />
                </shape>
            </item>
            <!-- Direct soft shadow -->
            <item
                android:top="1dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/todayTileShadow" />
                    <corners android:radius="@dimen/radiusSmall" />
                </shape>
            </item>
            <!-- Top edge highlight -->
            <item
                android:top="0dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/todayTileHighlight" />
                    <corners android:radius="@dimen/radiusSmall" />
                </shape>
            </item>
            <!-- Raised tile surface -->
            <item
                android:top="1dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/todayTile" />
                    <stroke
                        android:width="@dimen/strokeHairline"
                        android:color="@color/todayTileStroke" />
                    <corners android:radius="@dimen/radiusSmall" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
