<?xml version="1.0" encoding="utf-8"?>
<!-- Outline drawn around a widget card while it is being resized, like the stock launcher's
     resize frame: the border marks the card as grabbable and the faint scrim lifts it off
     the wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/scrimHomeTopFade" />
    <stroke
        android:width="@dimen/strokeThin"
        android:color="?attr/accentColor" />
    <corners android:radius="@dimen/radiusMedium" />
</shape>
