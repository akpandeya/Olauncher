<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <ripple android:color="?attr/primaryColorTrans50">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/primaryColorTrans50" />
                    <stroke
                        android:width="@dimen/strokeHairline"
                        android:color="?attr/primaryColor" />
                    <corners android:radius="@dimen/radiusPill" />
                </shape>
            </item>
        </ripple>
    </item>
    <item android:drawable="@drawable/today_chip" />
</selector>
