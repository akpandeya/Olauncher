<?xml version="1.0" encoding="utf-8"?>
<!-- Live height readout shown above the drag strip while a widget card is being resized.
     Uses only attributes that resolve in the widget-host context (no app-theme chips). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/scrimHandle" />
    <stroke
        android:width="@dimen/strokeHairline"
        android:color="?attr/accentColor" />
    <corners android:radius="@dimen/radiusPill" />
</shape>
