<?xml version="1.0" encoding="utf-8"?>
<!-- Scrim behind the pause text block: solid at the bottom where the buttons are, fading out above the title. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="@color/pauseScrim"
        android:centerY="0.7"
        android:endColor="@color/scrimClear"
        android:startColor="@color/pauseScrim"
        android:type="linear" />
</shape>
