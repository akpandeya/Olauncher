<?xml version="1.0" encoding="utf-8"?>
<!-- Soft dark wash behind the home clock: about 38% black at the top, fading to clear. No edges or corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/scrimHomeTopFade"
        android:centerY="0.55"
        android:endColor="@color/scrimClear"
        android:startColor="@color/scrimHomeTop"
        android:type="linear" />
</shape>
