<?xml version="1.0" encoding="utf-8"?>
<!-- Soft dark wash behind the home clock: about 38% black at the top, fading to clear. No edges or corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#26000000"
        android:centerY="0.55"
        android:endColor="#00000000"
        android:startColor="#61000000"
        android:type="linear" />
</shape>
