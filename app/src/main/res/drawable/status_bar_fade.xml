<?xml version="1.0" encoding="utf-8"?>
<!-- Fades scrolling content out under the status bar: the screen's card colour at the top. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/scrimClear"
        android:startColor="@color/readableCard"
        android:type="linear" />
</shape>
