<?xml version="1.0" encoding="utf-8"?>
<!-- Conjugation quiz option: selected = picked, activated = the right form -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/todayChipColor" />
            <stroke
                android:width="2dp"
                android:color="?attr/accentColor" />
            <corners android:radius="@dimen/radiusMedium" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/primaryColorTrans50" />
            <stroke
                android:width="@dimen/strokeHairline"
                android:color="?attr/primaryColor" />
            <corners android:radius="@dimen/radiusMedium" />
        </shape>
    </item>
    <item>
        <ripple android:color="?attr/primaryColorTrans50">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/todayChipColor" />
                    <corners android:radius="@dimen/radiusMedium" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
