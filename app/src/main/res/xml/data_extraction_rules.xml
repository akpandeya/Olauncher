<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <include domain="sharedpref" path="app.olauncher.xml" />
        <include domain="file" path="saved_items.json" />
        <include domain="file" path="word_progress.json" />
        <include domain="file" path="words.json" />
        <include domain="file" path="usage_days.json" />
        <include domain="file" path="intention_history.json" />
        <include domain="file" path="review_events.json" />
        <include domain="file" path="practice_items.json" />
        <exclude domain="file" path="wallpapers/" />
        <!-- Belt-and-braces: the OS never backs up noBackupFilesDir (#599). -->
        <exclude domain="root" path="no_backup/ai_key.bin" tools:ignore="FullBackupContent" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="app.olauncher.xml" />
        <include domain="file" path="saved_items.json" />
        <include domain="file" path="word_progress.json" />
        <include domain="file" path="words.json" />
        <include domain="file" path="usage_days.json" />
        <include domain="file" path="intention_history.json" />
        <include domain="file" path="review_events.json" />
        <include domain="file" path="practice_items.json" />
        <exclude domain="file" path="wallpapers/" />
        <!-- Belt-and-braces: the OS never backs up noBackupFilesDir (#599). -->
        <exclude domain="root" path="no_backup/ai_key.bin" tools:ignore="FullBackupContent" />
    </device-transfer>
</data-extraction-rules>